{% raw -%}
name: publish-image

# Builds the backend image and pushes it to a container registry. No cloud
# provisioning and no auto-redeploy: this only publishes the artifact.
#
# Defaults to GitHub Container Registry (ghcr.io) using the built-in
# GITHUB_TOKEN, so it works with zero setup. To target another registry set:
#   vars.REGISTRY         e.g. 123456789012.dkr.ecr.ap-south-1.amazonaws.com
#   vars.IMAGE_NAME       e.g. my-app-backend   (default: this repo's name)
#   secrets.REGISTRY_USERNAME / secrets.REGISTRY_PASSWORD
# For ECR with GitHub OIDC (no static keys) replace the "Log in" step with the
# commented aws-actions block below.
#
{% endraw %}{% if ci_runner == 'blacksmith' %}# Runs on Blacksmith: the image is built with useblacksmith/setup-docker-builder,
# which keeps the BuildKit cache on a disk attached to the runner (no GHA cache
# export/import).
#
{% endif %}{% raw %}# Tags: <branch>-<short_sha> (immutable-friendly) and <branch>-latest (floating).
# The floating tag is re-pushed on every build, so the registry repository must
# allow mutable tags. ECR repositories created with image_tag_mutability =
# IMMUTABLE reject the second push; use MUTABLE, or drop the -latest tag below.

on:
  push:
    branches: [main] # add branches here to publish per-branch images

permissions:
  contents: read
  packages: write # ghcr.io only
  # id-token: write # uncomment for ECR via OIDC

concurrency:
  group: publish-image-${{ github.ref }}
  cancel-in-progress: true

env:
  REGISTRY: ${{ vars.REGISTRY || 'ghcr.io' }}
  IMAGE_NAME: ${{ vars.IMAGE_NAME || github.repository }}

jobs:
  publish:
{% endraw %}    runs-on: {{ blacksmith_runner if ci_runner == 'blacksmith' else 'ubuntu-latest' }}
{% raw %}    steps:
      - uses: actions/checkout@v6

      - name: Log in (ghcr.io)
        if: ${{ env.REGISTRY == 'ghcr.io' }}
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Log in (other registry)
        if: ${{ env.REGISTRY != 'ghcr.io' }}
        uses: docker/login-action@v3
        with:
          registry: ${{ env.REGISTRY }}
          username: ${{ secrets.REGISTRY_USERNAME }}
          password: ${{ secrets.REGISTRY_PASSWORD }}

      # ECR via OIDC instead of the step above:
      # - uses: aws-actions/configure-aws-credentials@v4
      #   with:
      #     role-to-assume: ${{ vars.AWS_ROLE_ARN }}
      #     aws-region: ${{ vars.AWS_REGION }}
      # - uses: aws-actions/amazon-ecr-login@v2

      - name: Compute tags
        id: tags
        run: |
          branch="${GITHUB_REF_NAME//\//-}"
          image="${REGISTRY}/${IMAGE_NAME}"
          image="$(echo "$image" | tr '[:upper:]' '[:lower:]')"
          echo "list=${image}:${branch}-${GITHUB_SHA::7},${image}:${branch}-latest" >> "$GITHUB_OUTPUT"

{% endraw %}{% if ci_runner == 'blacksmith' %}      - uses: useblacksmith/setup-docker-builder@v2
        with:
          cache-key: backend/Dockerfile # one key per unrelated image

      - uses: useblacksmith/build-push-action@v2
        with:
          context: backend
          push: true
          tags: ${{ '{{' }} steps.tags.outputs.list {{ '}}' }}
{% else %}      - uses: docker/setup-buildx-action@v3

      - uses: docker/build-push-action@v6
        with:
          context: backend
          push: true
          tags: ${{ '{{' }} steps.tags.outputs.list {{ '}}' }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
{% endif %}
