{% if auth != 'none' %}import 'package:flutter/foundation.dart';
{% endif %}import 'package:go_router/go_router.dart';
import 'package:riverpod_annotation/riverpod_annotation.dart';
{% if auth != 'none' %}
import '../auth/auth_controller.dart';
{%- endif %}
import '../screens/home_screen.dart';
{%- if auth != 'none' %}
import '../screens/login_screen.dart';
{%- endif %}
{%- if auth == 'jwt' and verification_method == 'otp' %}
import '../screens/otp_screen.dart';
{%- endif %}
{%- if auth != 'none' %}
import '../screens/signup_screen.dart';
{%- endif %}
// newdomain:imports
import 'app_shell.dart';

part 'app_router.g.dart';

@riverpod
GoRouter appRouter(Ref ref) {
{%- if auth != 'none' %}
  // Bridge the auth state into a Listenable so GoRouter re-evaluates redirects.
  final refresh = ValueNotifier<Object?>(null);
  ref
    ..onDispose(refresh.dispose)
    ..listen(
      authControllerProvider,
      (_, next) => refresh.value = next,
      fireImmediately: true,
    )
{%- if auth == 'jwt' and verification_method == 'otp' %}
    ..listen(
      pendingVerificationControllerProvider,
      (_, next) => refresh.value = next,
      fireImmediately: true,
    )
{%- endif %};

{%- endif %}{% if auth != 'none' %}
{% endif %}
  return GoRouter(
    initialLocation: '/',
{%- if auth != 'none' %}
    refreshListenable: refresh,
{%- endif %}
{%- if auth != 'none' %}
    redirect: (context, state) {
      final auth = ref.read(authControllerProvider);
      if (auth.isLoading) return null; // wait for the initial load
      final loggedIn = auth.value != null;
{%- if auth == 'jwt' and verification_method == 'otp' %}
      final awaitingOtp =
          ref.read(pendingVerificationControllerProvider) != null;
      final onOtpScreen = state.matchedLocation == '/verify';
      if (!loggedIn && awaitingOtp) return onOtpScreen ? null : '/verify';
      if (onOtpScreen) return loggedIn ? '/' : '/login';
{%- endif %}
      final onAuthScreen = state.matchedLocation == '/login' ||
          state.matchedLocation == '/signup';

      if (!loggedIn && !onAuthScreen) return '/login';
      if (loggedIn && onAuthScreen) return '/';
      return null;
    },
{%- endif %}
    routes: [
{%- if auth != 'none' %}
      GoRoute(path: '/login', builder: (_, _) => const LoginScreen()),
      GoRoute(path: '/signup', builder: (_, _) => const SignupScreen()),
{%- if auth == 'jwt' and verification_method == 'otp' %}
      GoRoute(path: '/verify', builder: (_, _) => const OtpScreen()),
{%- endif %}
{%- endif %}
      // {% if auth != 'none' %}Authenticated routes{% else %}Routes{% endif %} share the AppShell (app bar{% if auth != 'none' %} + sign-out{% endif %}). Add new
      // {% if auth != 'none' %}authed {% endif %}screens as GoRoute entries here.
      ShellRoute(
        builder: (context, state, child) => AppShell(child: child),
        routes: [
          GoRoute(path: '/', builder: (_, _) => const HomeScreen()),
          // newdomain:routes
        ],
      ),
    ],
  );
}
